<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <!-- Pin the self-contained release runtime; do not depend on machine patch level. -->
    <OtpeekReleaseRuntimeVersion>10.0.15</OtpeekReleaseRuntimeVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>OTPeek Team</Authors>
    <Company>OTPeek</Company>
    <Product>OTPeek</Product>
    <Copyright>Copyright (c) 2024</Copyright>
    <Version>1.0.0</Version>
  </PropertyGroup>
</Project>
