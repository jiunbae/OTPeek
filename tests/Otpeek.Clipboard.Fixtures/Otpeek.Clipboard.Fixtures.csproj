<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <RuntimeIdentifiers />
    <Platforms>AnyCPU</Platforms>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Otpeek.Core.Windows"><HintPath>$(OtpeekPayloadDir)/Otpeek.Core.Windows.dll</HintPath></Reference>
    <Reference Include="Otpeek.Core"><HintPath>$(OtpeekPayloadDir)/Otpeek.Core.dll</HintPath></Reference>
  </ItemGroup>
  <Target Name="RequirePayload" BeforeTargets="ResolveReferences">
    <Error Condition="'$(OtpeekPayloadDir)' == '' or !Exists('$(OtpeekPayloadDir)/Otpeek.Core.Windows.dll')"
           Text="Pass the extracted candidate MSIX directory as OtpeekPayloadDir." />
  </Target>
</Project>
