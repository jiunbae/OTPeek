<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Otpeek.App</RootNamespace>
    <AssemblyName>Otpeek</AssemblyName>
    <!-- Embed the established OTPeek artwork in unpackaged/dev executables too. -->
    <ApplicationIcon>Assets\Logo\app.ico</ApplicationIcon>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- 개발: None (기본), Widget 테스트: MSIX (-p:WindowsPackageType=MSIX) -->
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Self-contained for dev sideloading -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows App SDK -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260710003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />

    <!-- MVVM Toolkit -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Primitives" Version="8.1.240916" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" Version="8.1.240916" />

    <!-- System Tray -->
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.1.3" />

    <!-- DI -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Otpeek.Core\Otpeek.Core.csproj" />
    <ProjectReference Include="..\Otpeek.Core.Windows\Otpeek.Core.Windows.csproj" />
    <!-- Generated Rust core bindings + native otpeek_ffi.dll (flows to app output). -->
    <ProjectReference Include="..\Otpeek.Interop\Otpeek.Interop.csproj" />
  </ItemGroup>

  <!-- Stage widget content before the SDK assigns/package-computes content paths.
       Copying after Build and adding AppxPackagePayload missed the actual MSIX. -->
  <Target Name="StageWidgetForPackage" BeforeTargets="AssignTargetPaths" Condition="'$(WindowsPackageType)' == 'MSIX'">
    <MSBuild Projects="..\Otpeek.Widget\Otpeek.Widget.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);Platform=$(Platform)" />
    <PropertyGroup>
      <WidgetOutputPath>..\Otpeek.Widget\bin\$(Platform)\$(Configuration)\net8.0-windows10.0.22621.0</WidgetOutputPath>
      <WidgetOutputPath Condition="'$(RuntimeIdentifier)' != ''">$(WidgetOutputPath)\$(RuntimeIdentifier)</WidgetOutputPath>
    </PropertyGroup>
    <ItemGroup>
      <Content Include="$(WidgetOutputPath)\Otpeek.Widget.exe">
        <Link>Otpeek.Widget.exe</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="$(WidgetOutputPath)\Otpeek.Widget.dll">
        <Link>Otpeek.Widget.dll</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="$(WidgetOutputPath)\Otpeek.Widget.deps.json">
        <Link>Otpeek.Widget.deps.json</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="$(WidgetOutputPath)\Otpeek.Widget.runtimeconfig.json">
        <Link>Otpeek.Widget.runtimeconfig.json</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="$(WidgetOutputPath)\Otpeek.Widget.pri">
        <Link>Otpeek.Widget.pri</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="..\Otpeek.Widget\Templates\OtpWidgetTemplate.json">
        <Link>Templates\OtpWidgetTemplate.json</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Content Include="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Public\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Update="Package.appxmanifest">
      <SubType>Designer</SubType>
    </None>
  </ItemGroup>

  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

</Project>
