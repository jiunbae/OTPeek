<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <OutputType>Library</OutputType>
    <RootNamespace>Otpeek.Core.Windows</RootNamespace>
    <AssemblyName>Otpeek.Core.Windows</AssemblyName>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Otpeek.Core\Otpeek.Core.csproj" />
    <!-- Generated C# bindings for the shared Rust core + native otpeek_ffi.dll packaging. -->
    <ProjectReference Include="..\Otpeek.Interop\Otpeek.Interop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- QR Code (Windows specific) -->
    <!-- The net10.0 binding also exposes WPF APIs and references WindowsBase10.
         This WinUI shell needs only Bitmap APIs. Use the same package's supported
         netstandard2.0 binding to avoid importing an unused WPF runtime contract. -->
    <PackageReference Include="ZXing.Net.Bindings.Windows.Compatibility" Version="0.16.17"
                      GeneratePathProperty="true" ExcludeAssets="compile;runtime" />
    <!-- Keep the existing transitive decoder explicit when filtering binding assets. -->
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <Reference Include="ZXing.Windows.Compatibility">
      <HintPath>$(PkgZXing_Net_Bindings_Windows_Compatibility)\lib\netstandard2.0\ZXing.Windows.Compatibility.dll</HintPath>
      <Private>true</Private>
    </Reference>

    <!-- System.Drawing for screen capture -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.15" />

    <!-- DPAPI for secure storage -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.15" />

    <!-- DI -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
  </ItemGroup>

</Project>
